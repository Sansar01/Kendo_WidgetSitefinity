@Html.StyleSheet("https://kendo.cdn.telerik.com/2018.1.117/styles/kendo.common.min.css", "head")
@Html.StyleSheet("https://kendo.cdn.telerik.com/2018.1.117/styles/kendo.blueopal.min.css", "head")
@Html.Script(ScriptRef.JQuery, "head")
@Html.Script(ScriptRef.KendoAll, "head")
@Html.Script(Url.WidgetContent("https://kendo.cdn.telerik.com/2025.4.1217/js/kendo.aspnetmvc.min.js"), "head")
@Html.Script(Url.WidgetContent("Mvc/Scripts/kendo-books-widget.js"), "top")
@*<script src="~/Scripts/telerik-license.js"></script>*@


<input id="sfAppPath" type="hidden" value="@ViewBag.sfAppPath" />
<div data-role="books-widget"></div>

<div class="container">
    <div class="row">
        @(Html.Kendo().Grid<Book>()
    .Name("booksGrid")
    .EnableCustomBinding(true)
    .Columns(columns =>
    {
        columns.Bound(book => book.Title).Width(140);
        columns.Bound(book => book.Author).Width(140);
        columns.Bound(book => book.Points).Width(40);-
        columns.Command(command => command.Custom("Vote").Click("vote"));
    })
    .Pageable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(5)
        .Read(read => read.Url(Url.HttpRouteUrl("/home", new { controller = "Kendo", action = "Books" })))));
    </div>
</div>